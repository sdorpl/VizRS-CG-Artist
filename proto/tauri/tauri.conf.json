{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VizRS CG Artist",
  "mainBinaryName": "vizrs-cg-artist",
  "version": "0.2.0",
  "identifier": "pl.vizrs.CgArtist",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Edytor grafik i animacji VizRS",
    "longDescription": "Samodzielny edytor scen i animacji grafiki telewizyjnej VizRS. Działa bez serwera; sceny wysyła na serwer vizrs (Trio).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cgpack"
        ],
        "name": "Paczka VizRS",
        "description": "Paczka belek VizRS",
        "mimeType": "application/x-vizrs-cgpack",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/desktop.hbs",
        "files": {
          "/usr/share/mime/packages/pl.vizrs.CgArtist.xml": "../../packaging/pl.vizrs.CgArtist.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/mime/packages/pl.vizrs.CgArtist.xml": "../../packaging/pl.vizrs.CgArtist.xml"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
